{
  "name": "aether-vault",
  "version": "1.3.0",
  "description": "Secure Offline Password Manager and Desktop Vault",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build-win": "pkg . --targets node18-win-x64 --output dist/aether-vault.exe"
  },
  "dependencies": {
    "argon2-browser": "^1.18.0",
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "bin/**/*"
    ]
  }
}
